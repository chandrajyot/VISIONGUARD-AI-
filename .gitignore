# Node dependencies
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Model weights (auto-downloaded by Ultralytics / PyTorch)
*.pt
*.onnx
*.engine
backend/*.pt
backend/weights/*
!backend/weights/.gitkeep

# Python / Backend
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
backend/__pycache__/
backend/app/__pycache__/
backend/app/*/__pycache__/
backend/app/*/*/__pycache__/
*.db
backend/*.db
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/annotated/*
!backend/storage/annotated/.gitkeep
backend/storage/crops/*
!backend/storage/crops/.gitkeep

# Environment variables & Logs (Ignore local secrets)
.env
backend/.env
.env.local
*.log

# IDE & OS
.DS_Store
.idea/
.vscode/
*.swp
